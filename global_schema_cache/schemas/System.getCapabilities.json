{
  "method": "System.getCapabilities",
  "description": "Returns compact summaries of callable Actions and the current Action-catalog and Agent-guide revisions, with the Agent Guide included only when requested.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:46c89baed493789bfb9424bc488513360a2f0047f2a530a729933a4bbe4aff12",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "guide": {
        "default": "omit",
        "description": "omit returns only catalog metadata; content returns the guide text; path returns a local path when the caller shares the Dispatcher filesystem.",
        "type": "string",
        "enum": [
          "omit",
          "content",
          "path"
        ]
      }
    },
    "required": [
      "guide"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "catalogRevision": {
        "type": "string",
        "pattern": "^sha256:.*",
        "description": "Content revision of the current callable Action catalog."
      },
      "guideRevision": {
        "type": "string",
        "pattern": "^sha256:.*",
        "description": "Content revision of the Agent guide."
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "description": "Callable Action method name."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Compact Action-specific purpose and boundary."
            },
            "requiresPurpose": {
              "type": "boolean",
              "description": "Whether the Action requires a non-empty purpose field."
            }
          },
          "required": [
            "method",
            "description",
            "requiresPurpose"
          ],
          "additionalProperties": false,
          "description": "Compact summary used for Action discovery."
        },
        "description": "Callable Action summaries in the current catalog."
      },
      "agentGuide": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "content",
              "path"
            ],
            "description": "Whether the guide is inline content or a local path."
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "Guide content or path according to format."
          }
        },
        "required": [
          "format",
          "value"
        ],
        "additionalProperties": false,
        "description": "Optional Agent guide requested by the caller."
      }
    },
    "required": [
      "catalogRevision",
      "guideRevision",
      "actions"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "observation": {
        "type": "string",
        "description": "Facts directly observed by the Action or returned by its declared result schema."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "data": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "catalogRevision": {
            "type": "string",
            "pattern": "^sha256:.*",
            "description": "Content revision of the current callable Action catalog."
          },
          "guideRevision": {
            "type": "string",
            "pattern": "^sha256:.*",
            "description": "Content revision of the Agent guide."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Callable Action method name."
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Compact Action-specific purpose and boundary."
                },
                "requiresPurpose": {
                  "type": "boolean",
                  "description": "Whether the Action requires a non-empty purpose field."
                }
              },
              "required": [
                "method",
                "description",
                "requiresPurpose"
              ],
              "additionalProperties": false,
              "description": "Compact summary used for Action discovery."
            },
            "description": "Callable Action summaries in the current catalog."
          },
          "agentGuide": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "enum": [
                  "content",
                  "path"
                ],
                "description": "Whether the guide is inline content or a local path."
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Guide content or path according to format."
              }
            },
            "required": [
              "format",
              "value"
            ],
            "additionalProperties": false,
            "description": "Optional Agent guide requested by the caller."
          }
        },
        "required": [
          "catalogRevision",
          "guideRevision",
          "actions"
        ],
        "additionalProperties": false,
        "description": "Validated business result returned by the Action."
      }
    },
    "required": [
      "observation",
      "suggested_prompt",
      "data"
    ],
    "additionalProperties": false
  },
  "failureSchema": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable public failure code."
          },
          "message": {
            "type": "string",
            "description": "Concise public explanation for the failure code."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "observation": {
        "type": "string",
        "description": "Directly observed failure fact; it must not infer an unobserved browser side effect."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "details": {
        "type": "object",
        "description": "Only fields listed by the public error definition detailFields are returned; private execution diagnostics are omitted.",
        "additionalProperties": true
      }
    },
    "required": [
      "error",
      "observation",
      "suggested_prompt"
    ],
    "additionalProperties": false
  }
}