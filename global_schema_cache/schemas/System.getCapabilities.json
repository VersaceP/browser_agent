{
  "method": "System.getCapabilities",
  "description": "Returns compact summaries of callable Actions and the current Action-catalog and Agent-guide revisions, with the Agent Guide included only when requested.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "guide": {
        "default": "omit",
        "description": "omit returns only catalog metadata; content returns the selected guide text; path returns a local path when the caller shares the WebCross filesystem.",
        "type": "string",
        "enum": [
          "omit",
          "content",
          "path"
        ]
      },
      "guideName": {
        "default": "browser",
        "description": "Selects the Browser Skill or connection-and-recovery reference when guide is content or path. omit returns metadata only.",
        "type": "string",
        "enum": [
          "browser",
          "connection"
        ]
      }
    },
    "required": [
      "guide",
      "guideName"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "catalogRevision": {
        "type": "string",
        "format": "starts_with",
        "pattern": "^sha256:.*",
        "description": "Content revision of the current callable Action catalog."
      },
      "guideRevision": {
        "type": "string",
        "format": "starts_with",
        "pattern": "^sha256:.*",
        "description": "Content revision of the Browser Skill and its bundled references."
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "description": "Callable Action method name."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Compact Action-specific purpose and boundary."
            },
            "requiresPurpose": {
              "type": "boolean",
              "description": "Whether the Action requires a non-empty purpose field."
            }
          },
          "required": [
            "method",
            "description",
            "requiresPurpose"
          ],
          "additionalProperties": false,
          "description": "Compact summary used for Action discovery."
        },
        "description": "Callable Action summaries in the current catalog."
      },
      "agentGuide": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "content",
              "path"
            ],
            "description": "Whether the guide is inline content or a local path."
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "Guide content or path according to format."
          }
        },
        "required": [
          "format",
          "value"
        ],
        "additionalProperties": false,
        "description": "Optional selected Agent guide requested by the caller."
      }
    },
    "required": [
      "catalogRevision",
      "guideRevision",
      "actions"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "observation": {
        "type": "string",
        "description": "Facts directly observed by the Action or returned by its declared result schema."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "data": {
        "description": "Validated business result returned by the Action.",
        "type": "object",
        "properties": {
          "catalogRevision": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^sha256:.*",
            "description": "Content revision of the current callable Action catalog."
          },
          "guideRevision": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^sha256:.*",
            "description": "Content revision of the Browser Skill and its bundled references."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Callable Action method name."
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Compact Action-specific purpose and boundary."
                },
                "requiresPurpose": {
                  "type": "boolean",
                  "description": "Whether the Action requires a non-empty purpose field."
                }
              },
              "required": [
                "method",
                "description",
                "requiresPurpose"
              ],
              "additionalProperties": false,
              "description": "Compact summary used for Action discovery."
            },
            "description": "Callable Action summaries in the current catalog."
          },
          "agentGuide": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "enum": [
                  "content",
                  "path"
                ],
                "description": "Whether the guide is inline content or a local path."
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Guide content or path according to format."
              }
            },
            "required": [
              "format",
              "value"
            ],
            "additionalProperties": false,
            "description": "Optional selected Agent guide requested by the caller."
          }
        },
        "required": [
          "catalogRevision",
          "guideRevision",
          "actions"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "observation",
      "suggested_prompt",
      "data"
    ],
    "additionalProperties": false
  },
  "failureSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "description": "Stable public failure code."
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "description": "Concise public explanation of the failure."
      },
      "observation": {
        "description": "Directly observed failure fact.",
        "type": "string"
      },
      "suggested_prompt": {
        "description": "Guidance for the next recovery operation.",
        "type": "string"
      },
      "details": {
        "description": "Public details filtered by the failure definition allowlist.",
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
          "dialogs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Identifier of the pending dialog."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "alert",
                    "confirm",
                    "prompt",
                    "beforeunload",
                    "file-save",
                    "file-open",
                    "directory"
                  ],
                  "description": "Kind of pending dialog."
                },
                "message": {
                  "type": "string",
                  "maxLength": 16384,
                  "description": "Dialog message or title."
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 4096,
                  "description": "Default prompt value, without user input."
                },
                "supportedActions": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "cancel",
                      "select-files"
                    ]
                  },
                  "description": "Operations supported by this dialog."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "opening",
                    "open",
                    "resolving"
                  ],
                  "description": "Current native lifecycle state."
                },
                "multiple": {
                  "description": "Whether the original file request accepts multiple files.",
                  "type": "boolean"
                },
                "acceptTypes": {
                  "description": "File filters from the original request; browser and permission checks remain authoritative.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downloadId": {
                  "description": "Existing download waiting for this save destination.",
                  "type": "string",
                  "minLength": 1
                },
                "pageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "Page that owns this active native dialog."
                }
              },
              "required": [
                "id",
                "type",
                "message",
                "defaultValue",
                "supportedActions",
                "state",
                "pageId"
              ],
              "additionalProperties": false
            },
            "description": "Current native dialogs, independently of the business result."
          }
        },
        "required": [
          "dialogs"
        ],
        "additionalProperties": false,
        "description": "Present only when current native dialogs were observed."
      }
    },
    "required": [
      "code",
      "message"
    ],
    "additionalProperties": false
  }
}