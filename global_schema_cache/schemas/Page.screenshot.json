{
  "method": "Page.screenshot",
  "description": "Captures the full page, viewport, rectangular region, or resolved element as an image; element captures also return the target Semantic Tree.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:cfd8fb90a7d277b16cad96ea1f17db4c9f7bafbbb87796e52dd73fdf68732998",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID to capture."
      },
      "fullPage": {
        "default": false,
        "description": "Capture the full scrollable page when true.",
        "type": "boolean"
      },
      "x": {
        "description": "Left coordinate for region capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "y": {
        "description": "Top coordinate for region capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "width": {
        "description": "Region width for partial capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "height": {
        "description": "Region height for partial capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "selector": {
        "description": "Fallback CSS selector for element capture.",
        "type": "string",
        "minLength": 1
      },
      "id": {
        "description": "Preferred canonical element ID for element capture.",
        "type": "string",
        "pattern": "^\\d+:\\d+:\\d+$"
      },
      "options": {
        "description": "Output options for the screenshot result.",
        "type": "object",
        "properties": {
          "format": {
            "default": "file",
            "description": "Output format for the screenshot payload.",
            "type": "string",
            "enum": [
              "base64",
              "png",
              "jpeg",
              "dataUrl",
              "file"
            ]
          },
          "path": {
            "description": "Output path when format is \"file\".",
            "type": "string"
          },
          "quality": {
            "description": "JPEG quality when format is \"jpeg\".",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "format"
        ],
        "additionalProperties": true
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe the visual condition to verify, e.g., canvas output, layout overlap, CAPTCHA state, or proof-of-work screen"
      }
    },
    "required": [
      "pageId",
      "fullPage",
      "purpose"
    ],
    "additionalProperties": true
  },
