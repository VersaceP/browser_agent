{
  "method": "Page.screenshot",
  "description": "Captures the full page, viewport, rectangular region, or resolved element as an image.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:ceccd4cf3cd46954290b4ff6547bffaaa32f0836d6047d3f30ae72b459f15d73",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID to capture."
      },
      "fullPage": {
        "default": false,
        "description": "Capture the full scrollable page when true.",
        "type": "boolean"
      },
      "x": {
        "description": "Left coordinate for region capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "y": {
        "description": "Top coordinate for region capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "width": {
        "description": "Region width for partial capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "height": {
        "description": "Region height for partial capture.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "selector": {
        "description": "Fallback CSS selector for element capture.",
        "type": "string",
        "minLength": 1
      },
      "id": {
        "description": "Preferred opaque element ID for element capture.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "options": {
        "description": "Output options for the screenshot result.",
        "type": "object",
        "properties": {
          "format": {
            "default": "file",
            "description": "Output format for the screenshot payload.",
            "type": "string",
            "enum": [
              "base64",
              "png",
              "jpeg",
              "dataUrl",
              "file"
            ]
          },
          "path": {
            "description": "Output path when format is \"file\".",
            "type": "string"
          },
          "quality": {
            "description": "JPEG quality when format is \"jpeg\".",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "format"
        ],
        "additionalProperties": true
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe the visual condition to verify, e.g., canvas output, layout overlap, CAPTCHA state, or proof-of-work screen"
      }
    },
    "required": [
      "pageId",
      "fullPage",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "Page ID captured."
          },
          "path": {
            "description": "Output file path when a file was written.",
            "type": "string"
          },
          "data": {
            "description": "Inline image data when requested.",
            "type": "string"
          },
          "mimeType": {
            "type": "string",
            "description": "Image MIME type."
          },
          "width": {
            "type": "number",
            "minimum": 0,
            "description": "Captured width in pixels."
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "description": "Captured height in pixels."
          },
          "scaleFactor": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "System display scale factor used for the capture."
          },
          "target": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Resolved target summary for an element or region capture."
          },
          "resolvedBy": {
            "description": "Resolution mode used for the capture target.",
            "type": "string"
          },
          "mode": {
            "type": "string",
            "const": "full-page",
            "description": "Capture mode used."
          }
        },
        "required": [
          "pageId",
          "mimeType",
          "width",
          "height",
          "scaleFactor",
          "target",
          "mode"
        ],
        "additionalProperties": false
