{
  "method": "Fleet.setProxy",
  "description": "Applies a sanitized proxy configuration to a Fleet when its browser partition still permits proxy changes.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fleetId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Fleet whose Client session should apply the proxy."
      },
      "proxyConfig": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "const": "system",
                "description": "Use the system proxy configuration."
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "const": "direct",
                "description": "Connect directly without a proxy."
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "const": "fixed",
                "description": "Use the explicitly supplied proxy endpoint."
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "http",
                  "https",
                  "socks4",
                  "socks5"
                ],
                "description": "Proxy protocol."
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "Proxy hostname or IP address."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Proxy TCP port."
              },
              "username": {
                "description": "Optional proxy username.",
                "type": "string"
              },
              "password": {
                "description": "Optional proxy password.",
                "type": "string"
              },
              "bypass": {
                "description": "Host patterns that should bypass the proxy.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skipCertificateValidation": {
                "type": "boolean",
                "description": "Whether HTTPS certificate validation may be skipped."
              }
            },
            "required": [
              "mode",
              "protocol",
              "host",
              "port",
              "skipCertificateValidation"
            ],
            "additionalProperties": true
          }
        ],
        "description": "Normalized proxy configuration."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe the intent for this action."
      }
    },
    "required": [
      "fleetId",
      "proxyConfig",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fleetId": {
