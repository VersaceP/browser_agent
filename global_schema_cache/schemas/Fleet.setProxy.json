        "type": "string"
      },
      "applied": {
        "description": "Whether the sanitized proxy configuration was accepted.",
        "type": "boolean"
      },
      "status": {
        "description": "Whether the proxy update was confirmed or is still processing.",
        "type": "string",
        "enum": [
          "confirmed",
          "processing"
        ]
      },
      "proxy": {
        "description": "Sanitized proxy configuration summary.",
        "type": "object",
