        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "restartToken": {
        "description": "Token identifying a scheduled restart, or null when none was scheduled.",
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "description": "Whether the policy is staged, restarting, or confirmed active.",
        "type": "string",
        "enum": [
          "staged",
          "scheduled",
          "confirmed"
        ]
