{
  "method": "Fleet.setFppPolicy",
  "description": "Stages a fingerprint-protection profile for a Fleet and optionally confirms an immediate Client restart.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
