        "type": "string"
      },
      "applied": {
        "description": "Whether the policy was accepted by the Fleet.",
        "type": "boolean"
      },
      "restartRequested": {
        "description": "Whether an immediate Client restart was requested.",
        "type": "boolean"
      },
      "restartRequired": {
        "description": "Whether a restart is required before the policy takes effect.",
        "type": "boolean"
      },
      "policySummary": {
        "description": "Sanitized summary of the staged fingerprint policy.",
