        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the target elements."
      },
      "targets": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "description": "Preferred canonical element ID from DOM.getAXTree.",
              "type": "string",
              "pattern": "^\\d+:\\d+:\\d+$"
            },
            "selector": {
              "description": "Fallback CSS selector for the target element in the main frame.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "description": "DOM query target identified by id, selector, or both."
        },
        "description": "Targets to read, preserving input order in response.data.items."
      },
      "attributes": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "description": "Attribute name to read, such as \"href\", \"value\", or \"aria-checked\"."
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Attribute name to read, such as \"href\", \"value\", or \"aria-checked\"."
            },
            "description": "Attribute names to read. An empty array reads all attributes."
          }
        ],
        "description": "Attribute name or names to read from every target. Use [] to read all attributes."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why these attributes are needed, e.g., checking a link href, validating aria state, reading an input value, or debugging selector stability"
      }
    },
    "required": [
      "pageId",
      "targets",
      "attributes",
      "purpose"
    ],
    "additionalProperties": true
  },
