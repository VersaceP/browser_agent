{
  "method": "Page.handleDialog",
  "description": "Handles page dialogs (alert/confirm/prompt).",
  "params": {
    "pageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "required": true
    },
    "accept": {
      "type": "boolean",
      "required": true
    },
    "userInput": {
      "type": "string",
      "required": false
    },
    "purpose": {
      "type": "string",
      "description": "Describe your intent for handling this dialog, e.g., confirming a submission",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe your intent for handling this dialog, e.g., confirming a submission"
}