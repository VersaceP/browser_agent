{
  "method": "Page.handleDialog",
  "description": "Resolves an active page dialog. Accept file-open or file-save with the current selection, or supply files to complete that same request. Directory dialogs support cancellation only. Use the pageId and dialog ID from current Action blockingInteractions or Page.dialogOpened.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID with the pending native dialog."
      },
      "accept": {
        "type": "boolean",
        "description": "True to accept the dialog, false to dismiss it."
      },
      "promptText": {
        "description": "Optional text for prompt dialogs when accepting.",
        "type": "string"
      },
      "dialogId": {
        "description": "Dialog ID from current blockingInteractions, a triggering Input receipt, or Page.dialogOpened; re-observe if that evidence is stale.",
        "type": "string",
        "minLength": 1
      },
      "files": {
        "description": "Absolute file paths for the active file dialog. Saving requires one complete destination path; opening follows the original single or multiple selection limit.",
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "overwrite": {
        "default": false,
        "description": "Allow replacing the explicitly supplied save destination. Requires accept=true and exactly one path in files. Defaults to false.",
        "type": "boolean"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why the dialog should be accepted or dismissed, e.g., confirming submission or cancelling an unsafe prompt"
      }
    },
    "required": [
      "pageId",
      "accept",
      "overwrite",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the handled dialog."
      },
      "action": {
        "type": "string",
        "enum": [
          "accept",
          "dismiss"
        ],
        "description": "Dialog action applied."
      },
      "inputProvided": {
        "type": "boolean",
        "description": "Whether text input was supplied to a prompt dialog."
      },
      "dialogId": {
        "description": "Identifier of the completed dialog.",
        "type": "string",
        "minLength": 1
      },
      "dialogType": {
        "description": "Type of the completed dialog.",
        "type": "string",
        "enum": [
          "alert",
          "confirm",
          "prompt",
          "beforeunload",
          "file-save",
          "file-open",
          "directory"
        ]
      },
      "selectedFileCount": {
        "description": "Number of files accepted by a file dialog. This does not confirm upload or content writing.",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "downloadId": {
        "description": "The existing download whose save destination was accepted. Observe Download events for transfer completion.",
        "type": "string",
        "minLength": 1
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
          "dialogs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Identifier of the pending dialog."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "alert",
                    "confirm",
                    "prompt",
                    "beforeunload",
                    "file-save",
                    "file-open",
                    "directory"
                  ],
                  "description": "Kind of pending dialog."
                },
                "message": {
                  "type": "string",
                  "maxLength": 16384,
                  "description": "Dialog message or title."
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 4096,
                  "description": "Default prompt value, without user input."
                },
                "supportedActions": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "cancel",
                      "select-files"
                    ]
                  },
                  "description": "Operations supported by this dialog."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "opening",
                    "open",
                    "resolving"
                  ],
                  "description": "Current native lifecycle state."
                },
                "multiple": {
                  "description": "Whether the original file request accepts multiple files.",
                  "type": "boolean"
                },
                "acceptTypes": {
                  "description": "File filters from the original request; browser and permission checks remain authoritative.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downloadId": {
                  "description": "Existing download waiting for this save destination.",
                  "type": "string",
                  "minLength": 1
                },
                "pageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "Page that owns this active native dialog."
                }
              },
              "required": [
                "id",
                "type",
                "message",
                "defaultValue",
                "supportedActions",
                "state",
                "pageId"
              ],
              "additionalProperties": false
            },
            "description": "Current native dialogs, independently of the business result."
          }
        },
        "required": [
          "dialogs"
        ],
        "additionalProperties": false,
        "description": "Present only when current native dialogs were observed."
      }
    },
    "required": [
      "pageId",
      "action",
      "inputProvided"
    ],
    "additionalProperties": false
  },
