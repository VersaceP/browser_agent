{
  "method": "Input.click",
  "description": "Performs one or more clicks using a target id from page observation or a unique selector. For page-viewport coordinates, use Page.click. Reports click sequence completion and any dialog or file-chooser follow-up. A single click also reports synchronously opened pages without waiting for them to load. When an attributed download starts, waits within the Action deadline for its save dialog or a no-dialog outcome.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the click target."
      },
      "selector": {
        "description": "Fallback CSS selector for the click target.",
        "type": "string",
        "minLength": 1
      },
      "id": {
        "description": "Target ID obtained from the latest page observation. Refresh it after navigation or document replacement.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "force": {
        "default": false,
        "description": "Allow the existing covered-target override. This does not bypass identity or basic operation requirements.",
        "type": "boolean"
      },
      "clickCount": {
        "default": 1,
        "description": "Number of clicks to dispatch, from 1 to 100.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe the intended effect of this click, such as opening a menu, selecting a result, or submitting a form."
      }
    },
    "required": [
      "pageId",
      "force",
      "clickCount",
      "purpose"
    ],
    "additionalProperties": true
  },
