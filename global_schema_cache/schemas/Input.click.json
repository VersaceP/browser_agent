{
  "method": "Input.click",
  "description": "Clicks the specified element. Target via CSS selector or canonical element id.",
  "params": {
    "pageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "required": true
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "required": false
    },
    "id": {
      "type": "string",
      "pattern": "^\\d+:\\d+:\\d+$",
      "required": false
    },
    "x": {
      "type": "number",
      "required": false
    },
    "y": {
      "type": "number",
      "required": false
    },
    "purpose": {
      "type": "string",
      "description": "Describe your goal for clicking this element, e.g., submitting a login form",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe your goal for clicking this element, e.g., submitting a login form"
}