      },
      "button": {
        "description": "Mouse button dispatched.",
        "type": "string"
      },
      "clickCount": {
        "description": "Requested click count, present only when the full sequence completed.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "point": {
        "description": "Page point used for the click, when available.",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "resolutionSource": {
        "description": "How the target was located.",
        "type": "string"
      },
      "openedPages": {
        "description": "Pages synchronously opened by a single click; omitted when none were confirmed.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "pageId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Registered ID of the newly opened page."
            },
            "url": {
              "type": "string",
              "description": "Requested URL when the new page was registered."
            },
            "title": {
              "description": "Page title known at registration, when available.",
              "type": "string"
            },
            "lifecycle": {
              "type": "string",
              "const": "loading",
              "description": "Loading state at registration; document readiness is not confirmed."
            }
          },
          "required": [
            "pageId",
            "url",
            "lifecycle"
          ],
          "additionalProperties": false
        }
      },
      "dialog": {
        "description": "Registered dialog opened by this click; handled alerts and intercepted choosers are not returned here.",
