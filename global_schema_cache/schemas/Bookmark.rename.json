{
  "method": "Bookmark.rename",
  "description": "Renames a single bookmark by ID.",
  "params": {
    "fleetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Fleet ID whose bookmark should be changed.",
      "required": true
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque bookmark ID to rename.",
      "required": true
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "New bookmark title.",
      "required": true
    },
    "purpose": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "minLength": 1,
      "description": "Describe why you are renaming this bookmark or folder, e.g., better reflecting its purpose",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe why you are renaming this bookmark or folder, e.g., better reflecting its purpose"
}