      "files": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Files to set on the upload target."
      },
      "id": {
        "description": "Preferred canonical upload target ID.",
        "type": "string",
        "pattern": "^\\d+:\\d+:\\d+$"
      },
      "selector": {
        "description": "Fallback CSS selector for the upload target.",
        "type": "string",
        "minLength": 1
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Provide the local files and the upload control id or selector to inject them directly."
      }
    },
    "required": [
      "pageId",
      "files",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
