{
  "method": "File.handleChooser",
  "description": "Assigns local files to an upload input, or re-triggers a previously intercepted File System Access entry once to supply its file paths. Directory injection is not supported.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the upload target."
      },
      "files": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Local file paths. Supply one path for single-file opening or saving, or multiple paths for a confirmed multiple-file request."
      },
      "id": {
        "description": "Target ID obtained from the latest page observation. Refresh it after navigation or document replacement.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "selector": {
        "description": "Unique CSS selector for the actual upload input or confirmed File System Access entry.",
        "type": "string",
        "minLength": 1
      },
      "overwrite": {
        "default": false,
        "description": "Allow replacing an existing destination for a confirmed File System Access save request. The existing file is truncated before the save handle is returned; the page must then write its content. Does not apply to file uploads.",
        "type": "boolean"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "State which upload operation the files are intended to complete and identify the current upload control."
      }
    },
    "required": [
      "pageId",
      "files",
      "overwrite",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the upload target."
      },
      "handled": {
        "type": "boolean",
        "const": true,
        "description": "Confirms file assignment or completion of the confirmed File System Access request."
      },
      "selectedFileCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Number of files assigned."
      },
      "resolvedBy": {
        "type": "string",
        "const": "agent",
        "description": "Indicates that the Agent requested direct file assignment."
      },
      "targetResolvedBy": {
        "description": "How the upload target was located.",
        "type": "string",
        "enum": [
          "id",
          "selector",
          "selector-fallback"
        ]
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
          "dialogs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Identifier of the pending dialog."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "alert",
                    "confirm",
                    "prompt",
                    "beforeunload",
                    "file-save",
                    "file-open",
                    "directory"
                  ],
                  "description": "Kind of pending dialog."
                },
                "message": {
                  "type": "string",
                  "maxLength": 16384,
                  "description": "Dialog message or title."
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 4096,
                  "description": "Default prompt value, without user input."
                },
                "supportedActions": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "cancel",
                      "select-files"
                    ]
                  },
                  "description": "Operations supported by this dialog."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "opening",
                    "open",
                    "resolving"
                  ],
                  "description": "Current native lifecycle state."
                },
                "multiple": {
                  "description": "Whether the original file request accepts multiple files.",
                  "type": "boolean"
                },
                "acceptTypes": {
                  "description": "File filters from the original request; browser and permission checks remain authoritative.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downloadId": {
                  "description": "Existing download waiting for this save destination.",
                  "type": "string",
                  "minLength": 1
                },
                "pageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "Page that owns this active native dialog."
                }
              },
              "required": [
                "id",
                "type",
                "message",
                "defaultValue",
                "supportedActions",
                "state",
                "pageId"
              ],
              "additionalProperties": false
            },
            "description": "Current native dialogs, independently of the business result."
          }
        },
        "required": [
          "dialogs"
