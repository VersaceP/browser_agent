{
  "method": "File.handleChooser",
  "description": "Injects files directly into a resolved upload control.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:46c89baed493789bfb9424bc488513360a2f0047f2a530a729933a4bbe4aff12",
  "inputSchema": {
