                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "all-hosts",
                    "description": "Show in menus on every hostname."
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": true
              }
            ],
            "description": "Browser menu availability; does not restrict explicit Agent execution."
          }
        },
        "required": [
          "schemaVersion",
          "name",
          "entry",
          "files",
          "kind",
          "availability"
