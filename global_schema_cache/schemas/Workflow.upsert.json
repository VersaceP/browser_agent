        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1,
            "description": "Workflow document schema version."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Human-readable script name."
          },
          "description": {
            "description": "Optional script description.",
            "type": "string",
            "maxLength": 2000
          },
          "timeoutMs": {
            "description": "Total deadline in milliseconds, including pauses.",
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
