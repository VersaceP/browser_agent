          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Module exporting the entry function."
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "additionalProperties": {
              "type": "string"
