{
  "method": "Workflow.upsert",
  "description": "Creates a saved Workshop workflow or replaces an existing record by workshopId after successful compilation. Saves the complete manifest and optional folder and menu enablement.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
