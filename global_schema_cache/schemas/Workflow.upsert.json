            "description": "Package sources indexed by normalized path."
          },
          "kind": {
            "type": "string",
            "const": "webcross-workshop",
            "description": "Workshop document format."
          },
          "availability": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "hosts",
                    "description": "Show in menus on matching hostnames."
                  },
                  "hostnamePatterns": {
                    "minItems": 1,
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "description": "Hostname patterns controlling browser menu availability."
                  }
