{
  "method": "Input.scroll",
  "description": "Scrolls the page or a specific element. Target via CSS selector or canonical element id, or omit both to scroll the viewport.",
  "params": {
    "pageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "required": true
    },
    "selector": {
      "type": "string",
      "required": false
    },
    "id": {
      "type": "string",
      "pattern": "^\\d+:\\d+:\\d+$",
      "required": false
    },
    "direction": {
      "default": "down",
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "required": true
    },
    "amount": {
      "default": 300,
      "type": "number",
      "minimum": 0,
      "required": true
    },
    "purpose": {
      "type": "string",
      "description": "Describe why you are scrolling, e.g., viewing content at the bottom of the page",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe why you are scrolling, e.g., viewing content at the bottom of the page"
}