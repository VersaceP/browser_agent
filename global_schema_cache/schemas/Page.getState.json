    "properties": {
      "pageId": {
        "type": "string",
        "description": "Page ID whose state was read."
      },
      "status": {
        "type": "string",
        "enum": [
          "loading",
          "ready",
          "failed",
          "crashed"
        ],
        "description": "Page runtime status."
      },
      "url": {
        "type": "string",
        "description": "Current page URL."
      },
      "title": {
        "type": "string",
        "description": "Current document title."
      },
      "faviconUrl": {
        "description": "Current page favicon URL, when available.",
        "type": "string"
      },
      "zoomLevel": {
        "type": "number",
        "description": "Current page zoom level."
      },
      "isPinned": {
        "type": "boolean",
        "description": "Whether the page is pinned."
      },
      "isAudible": {
        "type": "boolean",
        "description": "Whether the page is producing audio."
      },
      "isMuted": {
        "type": "boolean",
        "description": "Whether the page audio is muted."
      },
      "isBlocked": {
        "type": "boolean",
        "description": "Whether the page currently has a blocking dialog."
      },
      "failure": {
        "description": "Latest public page failure, when present.",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "network",
                "description": "Stable page failure category for a navigation or network failure."
              },
              "code": {
                "type": "string",
                "const": "page-load-failed",
                "description": "Stable public page failure code."
              },
              "message": {
                "type": "string",
                "const": "The page did not reach a usable loaded state.",
                "description": "Stable public page failure summary."
              }
            },
            "required": [
              "kind",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "automation-unavailable",
                "description": "Stable page failure category for an unavailable automation surface."
              },
              "code": {
                "type": "string",
                "const": "page-not-ready",
                "description": "Stable public page failure code."
              },
              "message": {
                "type": "string",
                "const": "The page did not expose a usable main-frame accessibility structure.",
                "description": "Stable public page failure summary."
              }
            },
            "required": [
              "kind",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "renderer-lost",
                "description": "Stable page failure category for a lost renderer."
              },
              "code": {
                "type": "string",
                "const": "renderer-lost",
                "description": "Stable public page failure code."
              },
              "message": {
                "type": "string",
                "const": "The page renderer is unavailable.",
                "description": "Stable public page failure summary."
              }
            },
            "required": [
              "kind",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        ]
      },
      "hitl": {
        "type": "object",
        "properties": {
          "isPaused": {
            "type": "boolean",
            "description": "Whether the page is paused for human intervention."
          },
          "pauseReason": {
            "description": "Reason supplied when the page was paused.",
            "type": "string"
          }
        },
        "required": [
          "isPaused"
        ],
        "additionalProperties": false,
        "description": "Human-intervention pause state."
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
          "hasPendingDialog": {
            "type": "boolean",
            "description": "Whether a native modal dialog is pending."
          }
        },
        "required": [
          "hasPendingDialog"
        ],
        "additionalProperties": false,
        "description": "Active blocking interaction state."
      }
    },
    "required": [
      "pageId",
      "status",
      "url",
      "title",
      "zoomLevel",
      "isPinned",
      "isAudible",
      "isMuted",
      "isBlocked",
      "hitl",
      "blockingInteractions"
    ],
    "additionalProperties": false
  },
