{
  "method": "Page.getState",
  "description": "Returns the current lifecycle, blocking, crash, failure, and human-intervention state of a page.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:ceccd4cf3cd46954290b4ff6547bffaaa32f0836d6047d3f30ae72b459f15d73",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID whose current state should be synchronized."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why you need the current state, e.g., checking whether a page is ready, verifying no blocking dialog, or resuming after HITL"
      }
    },
    "required": [
      "pageId",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
