                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Original zero-based target index."
                },
                "target": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "The target supplied for this batch item."
                },
                "ok": {
                  "type": "boolean",
                  "const": true,
                  "description": "Whether image export succeeded."
                },
                "info": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "Exported image information."
                }
              },
              "required": [
                "index",
                "target",
                "ok",
                "info"
              ],
              "additionalProperties": {},
              "description": "One successful or failed image export item."
            },
            {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Original zero-based target index."
                },
