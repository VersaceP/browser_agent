                },
                "ok": {
                  "type": "boolean",
                  "const": false,
                  "description": "Whether image export succeeded."
                },
                "error": {
                  "description": "Failure details when a public classification is available.",
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Stable public image failure code."
