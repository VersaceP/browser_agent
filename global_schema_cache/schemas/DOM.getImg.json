{
  "method": "DOM.getImg",
  "description": "Exports image content from one or more page elements as files and optionally inline data.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:52691626582a5164f1e1aaafb5a9e390e6e1e95ccc27663283f74997776c3737",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the target image elements."
      },
      "targets": {
        "minItems": 1,
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "description": "Preferred canonical element ID from the latest DOM.getAXTree or DOM.getSemanticTree observation.",
              "type": "string",
              "pattern": "^\\d+:\\d+:\\d+$"
            },
            "selector": {
              "description": "Fallback CSS selector resolved in the main document and all nested author Shadow DOM trees.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "description": "DOM query target identified by id, selector, or both."
        },
        "description": "One to 32 targets to export, preserving input order in response.data.items."
      },
      "options": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Required output directory. Every successful image item is written to this directory with an automatic filename."
          },
          "format": {
            "default": "file",
            "description": "Response payload format. Successful images are always written to options.path; base64/dataUrl additionally include inline data.",
            "type": "string",
            "enum": [
              "file",
              "base64",
              "dataUrl"
            ]
          },
          "imageFormat": {
            "default": "auto",
            "description": "Preferred image encoding. auto preserves safe self-contained inline SVG, keeps supported raster sources when possible, and otherwise encodes PNG.",
            "type": "string",
            "enum": [
              "auto",
              "png",
              "jpeg",
              "webp"
            ]
          },
          "quality": {
            "default": 80,
            "description": "Quality for lossy encodings such as JPEG or WebP.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "timeout": {
            "default": 300,
            "description": "Maximum batch wait time for image loading, in seconds. 0 waits until every image finishes or fails.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "format",
          "imageFormat",
          "quality",
          "timeout"
        ],
        "additionalProperties": true,
        "description": "Required output options. path is an output directory, not a file path."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why these image files are needed, e.g., saving product thumbnails, collecting visual assets, or preserving image evidence"
      }
    },
    "required": [
      "pageId",
      "targets",
      "options",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
