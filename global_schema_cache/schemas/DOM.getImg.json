              "description": "Preferred opaque element ID from the current page observation.",
              "type": "string",
              "pattern": "^n_[0-9a-f]{16}$"
            },
            "selector": {
              "description": "Fallback CSS selector resolved in the main document and all nested author Shadow DOM trees.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "description": "DOM query target identified by id, selector, or both."
        },
        "description": "One to 32 targets to export, preserving input order in response.data.items."
      },
      "options": {
        "description": "Image output settings.",
        "type": "object",
        "properties": {
          "path": {
            "description": "Output directory. Defaults to Documents/Webcross/DomImg.",
            "type": "string",
            "minLength": 1
          },
          "format": {
            "default": "file",
            "description": "Response format. Images are saved as files; base64/dataUrl also return inline data.",
            "type": "string",
            "enum": [
              "file",
              "base64",
              "dataUrl"
            ]
          },
          "imageFormat": {
            "default": "auto",
            "description": "Preferred image encoding. auto preserves safe self-contained inline SVG, keeps supported raster sources when possible, and otherwise encodes PNG.",
            "type": "string",
            "enum": [
              "auto",
              "png",
              "jpeg",
              "webp"
            ]
          },
          "quality": {
            "default": 80,
            "description": "Quality for lossy encodings such as JPEG or WebP.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "timeoutMs": {
            "default": 300,
            "description": "Maximum batch wait time for image loading, in milliseconds. 0 waits until every image finishes or fails.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "format",
          "imageFormat",
          "quality",
          "timeoutMs"
        ],
        "additionalProperties": true
      },
