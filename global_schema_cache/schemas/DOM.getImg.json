                    },
                    "suggested_prompt": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Next-observation guidance for the image item."
                    },
                    "canFallback": {
                      "type": "boolean",
                      "description": "Whether screenshot fallback remains available."
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "suggested_prompt",
                    "canFallback"
                  ],
                  "additionalProperties": {}
                }
              },
              "required": [
                "index",
                "target",
                "ok"
              ],
              "additionalProperties": {},
              "description": "One failed image export item."
            }
          ],
          "description": "One successful or failed image export item."
        },
        "description": "Exported image records, including paths or inline data requested by the caller; failed items include their own suggested_prompt."
      },
      "summary": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Total number of requested image targets."
          },
          "succeeded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of successful image exports."
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of failed image exports."
          },
          "fallback": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of exports completed through screenshot fallback."
          }
        },
        "required": [
          "total",
          "succeeded",
          "failed",
          "fallback"
        ],
        "additionalProperties": false,
        "description": "Counts and export summary for the returned images."
      }
    },
    "required": [
      "items",
      "summary"
    ],
    "additionalProperties": false
  },
