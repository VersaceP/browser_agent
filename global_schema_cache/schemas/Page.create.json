{
  "method": "Page.create",
  "description": "Creates a page in a selected Fleet or, when fleetId is omitted, in a suitable existing Fleet or a newly created default Fleet.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:57787ad534cac0789a4ec5118fb0a773583a9790bab09bbabd5f03df913b3180",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fleetId": {
        "description": "Optional Fleet ID. Omit it to reuse a suitable Fleet or create a default Fleet for the page.",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "url": {
        "description": "Optional initial URL to open in the new page.",
        "type": "string",
        "format": "uri"
      }
    },
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fleetId": {
        "description": "Fleet ID that owns the new page.",
        "type": "string"
      },
      "pageId": {
        "description": "New page ID.",
        "type": "string"
      },
      "lifecycle": {
        "description": "Page lifecycle state after creation.",
        "type": "string"
      },
      "status": {
        "description": "Page runtime status after creation.",
        "type": "string"
      },
      "url": {
        "description": "Initial or current page URL.",
        "type": "string"
      },
      "navigationStarted": {
        "description": "Whether initial navigation was dispatched.",
        "type": "boolean"
      },
      "fleetSelection": {
        "description": "How the page Fleet was selected.",
        "type": "string",
        "enum": [
          "explicit",
          "reused",
          "created"
        ]
      }
    },
    "additionalProperties": {}
  },
