{
  "method": "Input.drag",
  "description": "Drags from one resolved source to a resolved target, coordinate, or bounded offset within the same document.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the drag source and destination."
      },
      "selector": {
        "description": "Fallback CSS selector for the drag source in the main document.",
        "type": "string",
        "minLength": 1
      },
      "id": {
        "description": "Current source node ID from the latest page observation. Use node IDs for endpoints inside an iframe.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "x": {
        "description": "Fallback source X coordinate in CSS pixels.",
        "type": "number"
      },
      "y": {
        "description": "Fallback source Y coordinate in CSS pixels.",
        "type": "number"
      },
      "destinationSelector": {
        "description": "CSS selector for the destination in the main document. Without destinationOffset, the drop point defaults to the destination center.",
        "type": "string",
        "minLength": 1
      },
      "destinationId": {
        "description": "Current destination node ID from the latest page observation. Use node IDs for endpoints inside an iframe, keeping both endpoints in one document. Without destinationOffset, the drop point defaults to the destination center.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "destinationX": {
        "description": "Fallback destination X coordinate.",
        "type": "number"
      },
      "destinationY": {
        "description": "Fallback destination Y coordinate.",
        "type": "number"
      },
      "destinationOffset": {
        "description": "Normalized point inside the destination (0–1). Use y=0.2/0.8 when upper/lower drop zones change the result.",
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Normalized horizontal drop position inside the destination, from 0 to 1."
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Normalized vertical drop position inside the destination, from 0 to 1."
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": true
      },
      "deltaX": {
        "description": "Relative horizontal drag offset when not using an explicit destination. If omitted while deltaY is provided, defaults to 0.",
        "type": "number"
      },
      "deltaY": {
        "description": "Relative vertical drag offset when not using an explicit destination. If omitted while deltaX is provided, defaults to 0.",
        "type": "number"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe the intended drag effect and keep the source and destination in the same document when using element endpoints."
      }
    },
    "required": [
      "pageId",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "const": true,
        "description": "The drag input completed. Verify the resulting page state before the next action."
      },
      "resolvedBy": {
        "description": "Resolution mode used for the drag endpoints.",
        "type": "string"
      },
      "dispatchMode": {
        "description": "Whether interactive hit testing or visible geometry was used.",
        "type": "string",
        "enum": [
          "interactive",
          "geometry-fallback"
        ]
      },
      "geometryFallbackEndpoints": {
        "description": "Endpoints that required visible geometry fallback.",
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "source",
            "destination"
          ]
        }
      },
      "clamped": {
        "description": "Whether the relative offset was shortened at the source document edge.",
        "type": "boolean"
      },
      "requested": {
        "description": "The requested relative offset; it does not represent a business value change.",
        "type": "object",
        "properties": {
          "dx": {
            "type": "number",
            "description": "Requested horizontal offset in the source document."
          },
          "dy": {
            "type": "number",
            "description": "Requested vertical offset in the source document."
          }
        },
        "required": [
          "dx",
          "dy"
        ],
        "additionalProperties": false
      },
      "actual": {
        "description": "The relative offset dispatched after clamping; verify the resulting control state separately.",
        "type": "object",
        "properties": {
          "dx": {
            "type": "number",
            "description": "Actual horizontal offset after edge clamping."
          },
          "dy": {
            "type": "number",
            "description": "Actual vertical offset after edge clamping."
          }
        },
        "required": [
          "dx",
          "dy"
        ],
        "additionalProperties": false
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
          "dialogs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Identifier of the pending dialog."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "alert",
                    "confirm",
                    "prompt",
                    "beforeunload",
                    "file-save",
                    "file-open",
                    "directory"
                  ],
                  "description": "Kind of pending dialog."
                },
                "message": {
                  "type": "string",
                  "maxLength": 16384,
                  "description": "Dialog message or title."
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 4096,
                  "description": "Default prompt value, without user input."
                },
                "supportedActions": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "cancel",
                      "select-files"
                    ]
                  },
                  "description": "Operations supported by this dialog."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "opening",
                    "open",
                    "resolving"
                  ],
                  "description": "Current native lifecycle state."
                },
                "multiple": {
                  "description": "Whether the original file request accepts multiple files.",
                  "type": "boolean"
                },
                "acceptTypes": {
                  "description": "File filters from the original request; browser and permission checks remain authoritative.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downloadId": {
                  "description": "Existing download waiting for this save destination.",
                  "type": "string",
                  "minLength": 1
                },
                "pageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "Page that owns this active native dialog."
                }
              },
              "required": [
                "id",
                "type",
                "message",
                "defaultValue",
                "supportedActions",
                "state",
                "pageId"
              ],
              "additionalProperties": false
            },
            "description": "Current native dialogs, independently of the business result."
          }
        },
        "required": [
          "dialogs"
        ],
        "additionalProperties": false,
        "description": "Present only when current native dialogs were observed."
      }
    },
    "required": [
      "success"
    ],
    "additionalProperties": false
  },
