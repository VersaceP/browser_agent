{
  "method": "Page.wheel",
  "description": "Dispatches a native wheel gesture at a page-viewport coordinate using either an explicit delta/state read or a scroll-to-boundary request, and reports the resulting scroll state.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:52691626582a5164f1e1aaafb5a9e390e6e1e95ccc27663283f74997776c3737",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Page ID to receive the wheel input."
          },
          "x": {
            "description": "Horizontal coordinate in page viewport CSS pixels. Defaults to 0.",
            "type": "number",
            "minimum": 0
          },
          "y": {
            "description": "Vertical coordinate in page viewport CSS pixels. Defaults to 0.",
            "type": "number",
            "minimum": 0
          },
          "scrollX": {
            "description": "Optional horizontal scroll delta in CSS pixels. Positive values scroll right; omit both deltas for a state read.",
            "type": "number"
          },
          "scrollY": {
            "description": "Optional vertical scroll delta in CSS pixels. Positive values scroll down; omit both deltas for a state read.",
            "type": "number"
          },
          "axis": {
            "description": "Not accepted in this Page.wheel form.",
            "not": {}
          },
          "edge": {
            "description": "Not accepted in this Page.wheel form.",
            "not": {}
          },
          "purpose": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "string",
            "minLength": 1,
            "description": "Describe the page coordinate and choose delta/state with optional scrollX/scrollY or boundary with edge and optional axis; do not provide axis without edge."
          }
        },
        "required": [
          "pageId",
          "purpose"
        ],
        "description": "Delta/state form: use optional scrollX and/or scrollY, and omit axis and edge.",
        "additionalProperties": true
      },
      {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
