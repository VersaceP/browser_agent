            "description": "Page ID to receive the wheel input."
          },
          "x": {
            "description": "Horizontal coordinate in page viewport CSS pixels. Defaults to 0.",
            "type": "number",
            "minimum": 0
          },
          "y": {
            "description": "Vertical coordinate in page viewport CSS pixels. Defaults to 0.",
            "type": "number",
            "minimum": 0
          },
          "scrollX": {
            "description": "Not accepted in this Page.wheel form.",
            "not": {}
          },
          "scrollY": {
            "description": "Not accepted in this Page.wheel form.",
            "not": {}
          },
          "axis": {
            "description": "Optional boundary axis. Defaults to vertical; valid only with edge.",
            "type": "string",
            "enum": [
              "vertical",
              "horizontal"
            ]
          },
          "edge": {
            "type": "string",
            "enum": [
              "start",
              "end"
            ],
            "description": "Required boundary: start or end on the selected axis."
