          "purpose": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "string",
            "minLength": 1,
            "description": "Describe the page coordinate and choose delta/state with optional scrollX/scrollY or boundary with edge and optional axis; do not provide axis without edge."
          }
        },
        "required": [
          "pageId",
          "edge",
          "purpose"
        ],
        "description": "Boundary form: provide edge and optionally axis, and omit scrollX and scrollY.",
        "additionalProperties": true
      }
    ]
  },
