{
  "method": "Input.select",
  "description": "Sets the final selection on a native or supported custom select.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:cfd8fb90a7d277b16cad96ea1f17db4c9f7bafbbb87796e52dd73fdf68732998",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the select control."
      },
      "id": {
        "description": "Canonical select control ID.",
        "type": "string",
        "pattern": "^\\d+:\\d+:\\d+$"
      },
      "selector": {
        "description": "Unique CSS selector for one select control.",
        "type": "string",
        "minLength": 1
      },
      "selections": {
        "minItems": 1,
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": true
            }
          ]
        },
        "description": "Final selection set. Use value for native selects and id or label for custom selects."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Inspect the select first, then submit the final selection set using the returned native values, option IDs, or exact option labels."
      }
    },
    "required": [
      "pageId",
      "selections",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "controlId": {
        "type": "string",
        "minLength": 1,
        "description": "Current canonical ID of the select control."
      },
      "controlKind": {
        "type": "string",
        "enum": [
          "native",
          "custom"
        ],
        "description": "Whether the control is native HTML or custom."
      },
      "selectionMode": {
        "type": "string",
        "enum": [
          "single",
          "multiple"
        ],
        "description": "Whether one or multiple options are selected."
      },
      "selected": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "description": "Current canonical option ID when available.",
              "type": "string"
            },
            "label": {
              "type": "string",
              "description": "Normalized option label."
            },
            "value": {
              "description": "Native option value when available.",
              "type": "string"
            },
            "selected": {
              "type": "boolean",
              "description": "Whether the option is currently selected."
            },
            "disabled": {
              "type": "boolean",
              "description": "Whether the option is disabled."
            }
          },
          "required": [
            "label",
            "selected",
            "disabled"
          ],
          "additionalProperties": false
        },
        "description": "Options confirmed as selected after the action."
      },
      "proof": {
        "type": "string",
        "enum": [
          "native-state",
          "option-state"
        ],
        "description": "State observation used to confirm the selection."
      },
      "expanded": {
        "type": "object",
        "properties": {
          "before": {
            "type": "boolean"
          },
          "after": {
            "type": "boolean"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "additionalProperties": false,
        "description": "Select expanded state before and after the action."
      }
    },
    "required": [
      "controlId",
      "controlKind",
      "selectionMode",
      "selected",
      "proof",
      "expanded"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "observation": {
        "type": "string",
        "description": "Facts directly observed by the Action or returned by its declared result schema."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "data": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "controlId": {
            "type": "string",
            "minLength": 1,
            "description": "Current canonical ID of the select control."
          },
          "controlKind": {
            "type": "string",
            "enum": [
              "native",
              "custom"
            ],
            "description": "Whether the control is native HTML or custom."
          },
          "selectionMode": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ],
            "description": "Whether one or multiple options are selected."
          },
          "selected": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Current canonical option ID when available.",
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "description": "Normalized option label."
                },
                "value": {
                  "description": "Native option value when available.",
                  "type": "string"
                },
                "selected": {
                  "type": "boolean",
                  "description": "Whether the option is currently selected."
                },
                "disabled": {
                  "type": "boolean",
                  "description": "Whether the option is disabled."
                }
              },
              "required": [
                "label",
                "selected",
                "disabled"
              ],
              "additionalProperties": false
            },
            "description": "Options confirmed as selected after the action."
          },
          "proof": {
            "type": "string",
            "enum": [
              "native-state",
              "option-state"
            ],
            "description": "State observation used to confirm the selection."
          },
          "expanded": {
            "type": "object",
            "properties": {
              "before": {
                "type": "boolean"
              },
              "after": {
                "type": "boolean"
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": false,
            "description": "Select expanded state before and after the action."
          }
        },
        "required": [
          "controlId",
          "controlKind",
          "selectionMode",
          "selected",
          "proof",
          "expanded"
        ],
        "additionalProperties": false,
        "description": "Validated business result returned by the Action."
      }
    },
    "required": [
      "observation",
      "suggested_prompt",
      "data"
    ],
    "additionalProperties": false
  },
  "failureSchema": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable public failure code."
          },
          "message": {
            "type": "string",
            "description": "Concise public explanation for the failure code."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "observation": {
        "type": "string",
        "description": "Directly observed failure fact; it must not infer an unobserved browser side effect."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "details": {
        "type": "object",
        "description": "Only fields listed by the public error definition detailFields are returned; private execution diagnostics are omitted.",
        "additionalProperties": true
      }
    },
    "required": [
      "error",
      "observation",
      "suggested_prompt"
    ],
    "additionalProperties": false
  },
  "purposeHint": "Inspect the select first, then submit the final selection set using the returned native values, option IDs, or exact option labels."
}