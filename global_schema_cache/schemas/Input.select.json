{
  "method": "Input.select",
  "description": "Selects native options directly or operates supported custom select options with the keyboard.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:4348a1a737674c20d6554ae434ea98050c0d5fee0d58837d1609a4b3e2d64b91",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the select control."
      },
      "id": {
        "description": "Canonical select control ID.",
        "type": "string",
        "pattern": "^\\d+:\\d+:\\d+$"
      },
      "selector": {
        "description": "Unique CSS selector for one select control.",
        "type": "string",
        "minLength": 1
      },
      "selections": {
        "minItems": 1,
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": true
            }
          ]
        },
        "description": "Requested selection set. Native selects require value; custom selects preserve id, label, and explicit value as independent match fields."
      },
      "startOption": {
        "description": "Optional custom-select exploration starting point returned by a previous Select action. Native selects ignore this field.",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": true
          }
        ]
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Inspect the select first, then preserve the returned option field semantics when submitting selections. Reuse a returned startOption only when the feedback requests continued exploration."
      }
    },
    "required": [
      "pageId",
      "selections",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "controlId": {
        "type": "string",
        "minLength": 1,
        "description": "Current canonical ID of the select control."
      },
      "controlKind": {
        "type": "string",
        "enum": [
          "native",
          "custom"
        ],
        "description": "Whether the control is native HTML or custom."
      },
      "selectionMode": {
        "type": "string",
        "enum": [
          "single",
          "multiple"
        ],
        "description": "Whether one or multiple options are selected."
      },
      "selected": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "description": "Stable option ID exposed by the current select menu.",
              "type": "string"
            },
            "label": {
              "type": "string",
              "description": "Normalized option label."
            },
            "value": {
              "description": "Native value or an explicit custom option value when available.",
              "type": "string"
            },
            "selected": {
              "type": "boolean",
              "description": "Whether the option is currently selected."
            },
            "disabled": {
              "type": "boolean",
              "description": "Whether the option is disabled."
            }
          },
          "required": [
            "label",
            "selected",
            "disabled"
          ],
          "additionalProperties": false
        },
        "description": "Native options confirmed as selected, or custom options recorded as selected during this operation."
      }
    },
    "required": [
      "controlId",
      "controlKind",
      "selectionMode",
      "selected"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "observation": {
        "type": "string",
        "description": "Facts directly observed by the Action or returned by its declared result schema."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "data": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "controlId": {
            "type": "string",
            "minLength": 1,
            "description": "Current canonical ID of the select control."
          },
          "controlKind": {
            "type": "string",
            "enum": [
              "native",
              "custom"
            ],
            "description": "Whether the control is native HTML or custom."
          },
          "selectionMode": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ],
            "description": "Whether one or multiple options are selected."
          },
          "selected": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Stable option ID exposed by the current select menu.",
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "description": "Normalized option label."
                },
                "value": {
                  "description": "Native value or an explicit custom option value when available.",
                  "type": "string"
                },
                "selected": {
                  "type": "boolean",
                  "description": "Whether the option is currently selected."
                },
                "disabled": {
                  "type": "boolean",
                  "description": "Whether the option is disabled."
                }
              },
              "required": [
                "label",
                "selected",
                "disabled"
              ],
              "additionalProperties": false
            },
            "description": "Native options confirmed as selected, or custom options recorded as selected during this operation."
          }
        },
        "required": [
          "controlId",
          "controlKind",
          "selectionMode",
          "selected"
        ],
        "additionalProperties": false,
        "description": "Validated business result returned by the Action."
      }
    },
    "required": [
      "observation",
      "suggested_prompt",
      "data"
    ],
    "additionalProperties": false
  },
  "failureSchema": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable public failure code."
          },
          "message": {
            "type": "string",
            "description": "Concise public explanation for the failure code."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "observation": {
        "type": "string",
        "description": "Directly observed failure fact; it must not infer an unobserved browser side effect."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "details": {
        "type": "object",
        "description": "Only fields listed by the public error definition detailFields are returned; private execution diagnostics are omitted.",
        "additionalProperties": true
      }
    },
    "required": [
      "error",
      "observation",
      "suggested_prompt"
    ],
    "additionalProperties": false
  },
  "purposeHint": "Inspect the select first, then preserve the returned option field semantics when submitting selections. Reuse a returned startOption only when the feedback requests continued exploration."
}