{
  "method": "Input.select",
  "description": "Sets a supported native choice control and confirms the result. Provide id or selector, or both. ID takes priority; an unavailable or stale ID falls back to the selector before input. Provide exactly one of selections or value: selections for select, or value for date, datetime-local, time, month, week, and color.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the native choice control."
      },
      "id": {
        "description": "Control ID obtained from the current page observation for the native choice control.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "selector": {
        "description": "Unique CSS selector for one native choice control.",
        "type": "string",
        "minLength": 1
      },
      "selections": {
        "description": "Non-empty array for a native select; each item accepts only value. Mutually exclusive with value.",
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "description": "Exact native option value returned by DOM.inspectSelect."
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": {}
        }
      },
      "value": {
        "description": "HTML date/time value or #RRGGBB color; mutually exclusive with selections.",
        "type": "string"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Inspect the control first. Use exact option values for select, HTML date/time formats for scalar inputs, and #RRGGBB for color. Custom controls require normal input interaction."
      }
    },
    "required": [
      "pageId",
      "purpose"
    ],
    "additionalProperties": true
  },
