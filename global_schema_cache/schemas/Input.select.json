{
  "method": "Input.select",
  "description": "Sets a supported native choice control and confirms the result. Use selections for select, or value for date, datetime-local, time, month, week, and color; never both.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:57787ad534cac0789a4ec5118fb0a773583a9790bab09bbabd5f03df913b3180",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the select control."
      },
      "id": {
        "description": "Current node ID from the latest page observation for the native choice control.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "selector": {
        "description": "Unique CSS selector for one select control.",
        "type": "string",
        "minLength": 1
      },
      "selections": {
        "description": "Exact option values for a native select; mutually exclusive with value.",
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "description": "Exact native option value returned by DOM.inspectSelect."
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": {}
        }
      },
      "value": {
        "description": "HTML date/time value or #RRGGBB color; mutually exclusive with selections.",
        "type": "string"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Inspect the control first. Use exact option values for select, HTML date/time formats for scalar inputs, and #RRGGBB for color. Custom controls require normal input interaction."
      }
    },
    "required": [
      "pageId",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "controlId": {
            "type": "string",
            "pattern": "^n_[0-9a-f]{16}$",
            "description": "Current control ID."
          },
          "type": {
            "type": "string",
            "const": "select",
            "description": "Native select control type."
          },
          "selectionMode": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ],
            "description": "Native selection mode."
          },
          "selected": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Normalized native option label."
                },
                "value": {
                  "type": "string",
                  "description": "Exact native option value."
                },
                "selected": {
                  "type": "boolean",
                  "description": "Whether the option is selected."
                },
                "disabled": {
                  "type": "boolean",
                  "description": "Whether the option is disabled."
                }
              },
              "required": [
                "label",
                "value",
                "selected",
                "disabled"
              ],
              "additionalProperties": false
            },
            "description": "Options confirmed as selected."
          }
        },
        "required": [
          "controlId",
          "type",
          "selectionMode",
          "selected"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "controlId": {
            "type": "string",
            "pattern": "^n_[0-9a-f]{16}$",
            "description": "Current control ID."
          },
          "type": {
            "type": "string",
            "enum": [
              "date",
              "datetime-local",
              "time",
              "month",
              "week",
              "color"
            ],
            "description": "Native scalar control type."
          },
          "value": {
            "type": "string",
            "description": "Confirmed normalized native value."
          }
        },
        "required": [
          "controlId",
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    ]
  },
