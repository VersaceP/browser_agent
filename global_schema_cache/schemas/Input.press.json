{
  "method": "Input.press",
  "description": "Simulates a keyboard key press (e.g., Enter, Escape, Tab).",
  "params": {
    "pageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "required": true
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "required": true
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Control",
          "Shift",
          "Alt",
          "Meta"
        ]
      },
      "required": false
    },
    "purpose": {
      "type": "string",
      "description": "Describe why you are pressing this key, e.g., pressing Enter to submit a search",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe why you are pressing this key, e.g., pressing Enter to submit a search"
}