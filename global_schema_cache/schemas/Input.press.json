                },
                "acceptTypes": {
                  "description": "File filters from the original request; browser and permission checks remain authoritative.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downloadId": {
                  "description": "Existing download waiting for this save destination.",
                  "type": "string",
                  "minLength": 1
                },
                "pageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "Page that owns this active native dialog."
                }
              },
              "required": [
                "id",
                "type",
                "message",
                "defaultValue",
                "supportedActions",
                "state",
                "pageId"
              ],
              "additionalProperties": false
            },
            "description": "Current native dialogs, independently of the business result."
          }
        },
        "required": [
          "dialogs"
        ],
        "additionalProperties": false,
        "description": "Present only when current native dialogs were observed."
      }
    },
    "additionalProperties": {}
