{
  "method": "Input.press",
  "description": "Sends a key with optional modifiers to the page or a specified target. A specified target is focused first; an untargeted press uses the page's current focus, and dialog or file-chooser interruptions are reported for follow-up.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID that should receive the key press."
      },
      "key": {
        "type": "string",
        "minLength": 1,
        "description": "Key value to press, such as \"Enter\", \"Escape\", or \"a\"."
      },
      "modifiers": {
        "description": "Optional modifier keys held while pressing the main key.",
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Control",
            "Shift",
            "Alt",
            "Meta"
          ]
        }
      },
      "selector": {
        "description": "Optional CSS selector to focus before pressing the key.",
        "type": "string",
        "minLength": 1
      },
      "id": {
        "description": "Current node ID from the latest page observation to focus before pressing the key.",
        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why this key is needed, such as submitting with Enter, closing an overlay with Escape, moving focus with Tab, or invoking a shortcut."
      }
    },
    "required": [
      "pageId",
      "key",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "key": {
        "description": "Keyboard key dispatched.",
        "type": "string"
      },
      "modifiers": {
        "description": "Modifier keys held during dispatch.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "target": {
        "description": "Target identity used for the key dispatch.",
        "type": "string"
      },
      "resolvedBy": {
        "description": "Actor or resolution mode that selected the target.",
        "type": "string"
      },
      "repeat": {
        "description": "Number of repeated key dispatches.",
        "type": "number"
      },
      "resolutionSource": {
        "description": "Target resolution route used by the action.",
        "type": "string"
      },
      "dialog": {
        "description": "Interactive native dialog returned by this key press; handled page alerts are not returned here.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier of the pending dialog."
          },
          "type": {
            "type": "string",
            "enum": [
              "alert",
              "confirm",
              "prompt",
              "beforeunload",
              "file-save",
              "file-open",
              "directory"
            ],
            "description": "Kind of pending dialog."
          },
          "message": {
            "type": "string",
            "maxLength": 16384,
            "description": "Dialog message or title."
          },
          "defaultValue": {
            "type": "string",
            "maxLength": 4096,
            "description": "Default prompt value, without user input."
          },
          "supportedActions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "accept",
                "cancel",
                "select-files"
              ]
            },
            "description": "Operations supported by this dialog."
          },
          "state": {
            "type": "string",
            "enum": [
              "opening",
              "open",
              "resolving"
            ],
            "description": "Current native lifecycle state."
          },
          "multiple": {
            "description": "Whether the original file request accepts multiple files.",
            "type": "boolean"
          },
          "acceptTypes": {
            "description": "File filters from the original request; browser and permission checks remain authoritative.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "downloadId": {
            "description": "Existing download waiting for this save destination.",
            "type": "string",
            "minLength": 1
          },
          "truncated": {
            "description": "Whether native dialog text was shortened.",
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "type",
          "message"
        ],
        "additionalProperties": false
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
