{
  "method": "DOM.getText",
  "description": "Reads text content from one or more specified page targets and returns a separate result for every target.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:52691626582a5164f1e1aaafb5a9e390e6e1e95ccc27663283f74997776c3737",
