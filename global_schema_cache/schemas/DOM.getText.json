    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the target elements."
      },
      "targets": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "description": "Current target ID from a recent DOM.getAXTree or DOM.getSemanticTree result.",
              "type": "string",
              "pattern": "^\\d+:\\d+:\\d+$"
            },
            "selector": {
              "description": "Fallback CSS selector for the target element in the main frame.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "description": "DOM query target identified by an ID, selector, or both."
        },
        "description": "Targets to read, preserving input order in response.data.items."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "State why the text is needed, such as verifying a status message, reading a result section, or extracting submitted feedback."
      }
    },
    "required": [
      "pageId",
      "targets",
      "purpose"
    ],
    "additionalProperties": true
  },
