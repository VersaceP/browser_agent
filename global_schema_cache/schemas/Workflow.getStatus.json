    "type": "object",
    "properties": {
      "workflowId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Public workflow ID returned by Workflow.execute or a Workflow.progress event."
      }
    },
    "required": [
      "workflowId"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workflowId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Opaque workflow ID."
      },
      "status": {
        "type": "string",
        "enum": [
          "running",
          "pausing",
          "paused",
          "succeeded",
          "failed"
        ],
        "description": "Current workflow lifecycle status."
      },
      "currentStepPath": {
        "description": "Canonical path of the current workflow step.",
        "type": "string"
      },
      "variableKeys": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Names of currently available workflow variables, without their values."
      },
      "resultCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Number of step results recorded so far."
      },
      "timing": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Workflow creation timestamp in milliseconds."
          },
          "startedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Workflow start timestamp in milliseconds."
          },
          "finishedAt": {
            "description": "Workflow finish timestamp when terminal.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Elapsed workflow duration in milliseconds."
          }
        },
        "required": [
          "createdAt",
          "startedAt",
          "durationMs"
        ],
        "additionalProperties": false,
        "description": "Current or terminal workflow timing summary."
      },
      "lastFailure": {
        "description": "Safe summary of the latest workflow failure.",
        "type": "object",
        "properties": {
          "code": {
            "description": "Stable workflow or nested Action failure code.",
            "type": "string"
          },
          "message": {
            "description": "Safe workflow failure summary.",
            "type": "string"
          },
          "stepPath": {
            "description": "Canonical path of the failed step.",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "workflowId",
      "status",
      "variableKeys",
      "resultCount",
      "timing"
    ],
    "additionalProperties": false
  },
