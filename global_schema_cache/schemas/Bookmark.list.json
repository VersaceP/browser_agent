{
  "method": "Bookmark.list",
  "description": "Lists bookmarks, optionally filtered by folder.",
  "params": {
    "folderId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ],
      "required": false
    },
    "limit": {
      "default": 500,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "required": true
    },
    "purpose": {
      "type": "string",
      "description": "Describe why you are listing bookmarks, e.g., finding a saved page",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe why you are listing bookmarks, e.g., finding a saved page"
}