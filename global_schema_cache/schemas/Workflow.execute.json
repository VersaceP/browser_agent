{
  "method": "Workflow.execute",
  "description": "Compiles and runs an inline JavaScript or TypeScript package or a saved Workshop record. Supply exactly one of workflow or workshopId; both accept optional input and binding. Menu enablement and host rules do not restrict explicit execution.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
