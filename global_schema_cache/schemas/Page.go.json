  "method": "Page.go",
  "description": "Moves backward or forward through page navigation history using steps, a domain anchor, or a tag.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
