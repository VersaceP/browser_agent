{
  "method": "Page.click",
  "description": "Dispatches one or more physical clicks at a page-viewport CSS coordinate. For a target id from page observation or a unique selector, use Input.click. Coordinates do not scroll, resolve semantic targets, or recover stale targets; two clicks use the native double-click gesture and larger counts run bounded sequential clicks.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID that receives the click sequence."
      },
      "x": {
        "type": "number",
        "minimum": 0,
        "description": "Horizontal page-viewport coordinate in CSS pixels."
      },
      "y": {
        "type": "number",
        "minimum": 0,
        "description": "Vertical page-viewport coordinate in CSS pixels."
      },
      "clickCount": {
        "default": 1,
        "description": "Number of clicks to dispatch, from 1 to 100.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe the intended page effect at this exact viewport coordinate, such as activating a visual control that has no stable locator."
      }
    },
    "required": [
      "pageId",
      "x",
      "y",
      "clickCount",
      "purpose"
    ],
    "additionalProperties": true
  },
