{
  "method": "Emulation.setUserAgent",
  "description": "Spoofs the browser User-Agent string.",
  "params": {
    "pageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "required": true
    },
    "userAgent": {
      "type": "string",
      "minLength": 1,
      "required": true
    },
    "purpose": {
      "type": "string",
      "description": "Describe why you are changing the user agent, e.g., simulating mobile access",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe why you are changing the user agent, e.g., simulating mobile access"
}