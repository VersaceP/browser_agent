{
  "method": "System.register",
  "description": "Registers the current connection and returns the available Fleet, event, and catalog recovery state.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "descriptor": {
        "type": "object",
        "properties": {
          "model": {
            "description": "Externally declared model identifier, preferably in provider/model form.",
            "type": "string",
            "maxLength": 128
          },
          "client": {
            "description": "Externally declared client name, such as claude or codex.",
            "type": "string",
            "maxLength": 64
          }
        },
        "additionalProperties": true,
        "description": "Optional externally declared Agent attribution. It is informational and does not affect authentication."
      }
    },
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "minLength": 1,
        "description": "Agent ID assigned to this connection by the server."
      },
      "registered": {
        "type": "boolean",
        "const": true,
        "description": "Confirms that registration completed."
      },
      "catalogRevision": {
        "type": "string",
        "format": "starts_with",
        "pattern": "^sha256:.*",
        "description": "Content revision of the callable Action catalog."
      },
      "guideRevision": {
        "type": "string",
        "format": "starts_with",
        "pattern": "^sha256:.*",
        "description": "Content revision of the Browser Skill and its bundled references."
      },
      "eventCatalogRevision": {
        "type": "string",
        "minLength": 1,
        "description": "Content revision of the Agent-visible event catalog."
      },
      "eventCursor": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Next event cursor to use when reading Agent events."
      },
      "fleets": {
        "type": "array",
        "items": {},
        "description": "Authorized Fleet recovery summaries, each with its own prompt string and runtime memory."
      }
    },
    "required": [
      "agentId",
      "registered",
      "catalogRevision",
      "guideRevision",
      "eventCatalogRevision",
      "eventCursor",
      "fleets"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "observation": {
        "type": "string",
        "description": "Facts directly observed by the Action or returned by its declared result schema."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "data": {
        "description": "Validated business result returned by the Action.",
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "minLength": 1,
            "description": "Agent ID assigned to this connection by the server."
          },
          "registered": {
            "type": "boolean",
            "const": true,
            "description": "Confirms that registration completed."
          },
          "catalogRevision": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^sha256:.*",
            "description": "Content revision of the callable Action catalog."
          },
          "guideRevision": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^sha256:.*",
            "description": "Content revision of the Browser Skill and its bundled references."
          },
          "eventCatalogRevision": {
            "type": "string",
            "minLength": 1,
            "description": "Content revision of the Agent-visible event catalog."
          },
          "eventCursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Next event cursor to use when reading Agent events."
          },
          "fleets": {
            "type": "array",
            "items": {},
            "description": "Authorized Fleet recovery summaries, each with its own prompt string and runtime memory."
          }
        },
        "required": [
          "agentId",
          "registered",
          "catalogRevision",
          "guideRevision",
          "eventCatalogRevision",
          "eventCursor",
          "fleets"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "observation",
      "suggested_prompt",
      "data"
    ],
    "additionalProperties": false
  },
  "failureSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "description": "Stable public failure code."
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "description": "Concise public explanation of the failure."
      },
      "observation": {
        "description": "Directly observed failure fact.",
        "type": "string"
      },
      "suggested_prompt": {
        "description": "Guidance for the next recovery operation.",
        "type": "string"
      },
      "details": {
        "description": "Public details filtered by the failure definition allowlist.",
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
          "dialogs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Identifier of the pending dialog."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "alert",
                    "confirm",
                    "prompt",
                    "beforeunload",
                    "file-save",
                    "file-open",
                    "directory"
                  ],
                  "description": "Kind of pending dialog."
                },
                "message": {
                  "type": "string",
                  "maxLength": 16384,
                  "description": "Dialog message or title."
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 4096,
                  "description": "Default prompt value, without user input."
                },
                "supportedActions": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "cancel",
                      "select-files"
                    ]
                  },
                  "description": "Operations supported by this dialog."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "opening",
                    "open",
                    "resolving"
                  ],
                  "description": "Current native lifecycle state."
                },
                "multiple": {
                  "description": "Whether the original file request accepts multiple files.",
                  "type": "boolean"
                },
                "acceptTypes": {
                  "description": "File filters from the original request; browser and permission checks remain authoritative.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downloadId": {
                  "description": "Existing download waiting for this save destination.",
                  "type": "string",
                  "minLength": 1
                },
                "pageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "Page that owns this active native dialog."
                }
              },
              "required": [
                "id",
                "type",
                "message",
                "defaultValue",
                "supportedActions",
                "state",
                "pageId"
              ],
              "additionalProperties": false
            },
            "description": "Current native dialogs, independently of the business result."
          }
        },
        "required": [
          "dialogs"
        ],
        "additionalProperties": false,
        "description": "Present only when current native dialogs were observed."
      }
    },
    "required": [
      "code",
      "message"
    ],
    "additionalProperties": false
  }
}