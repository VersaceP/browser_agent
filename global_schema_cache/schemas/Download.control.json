        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Fleet ID whose download should be controlled."
      },
      "downloadId": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque download ID to control."
      },
      "command": {
        "type": "string",
        "enum": [
          "pause",
          "resume",
          "cancel"
        ],
        "description": "Lifecycle command to execute."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why you are changing the download state, e.g., pausing until network recovery"
      }
    },
    "required": [
      "fleetId",
      "downloadId",
      "command",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
