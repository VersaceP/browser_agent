      "data": {
        "description": "Validated business result returned by the Action.",
        "type": "object",
        "properties": {
          "downloadId": {
            "description": "Opaque download record ID controlled by this action.",
            "type": "string"
          },
          "requestedCommand": {
            "description": "Lifecycle command requested by the caller.",
            "type": "string",
