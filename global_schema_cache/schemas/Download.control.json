        "description": "Opaque download record ID controlled by this action.",
        "type": "string"
      },
      "requestedCommand": {
        "description": "Lifecycle command requested by the caller.",
        "type": "string",
        "enum": [
          "pause",
          "resume",
          "cancel"
        ]
      },
      "previousState": {
        "description": "Download state observed locally before the command was sent.",
        "type": "string"
      },
      "currentState": {
        "description": "Download state observed locally immediately after the command was sent; this is not guaranteed to be final.",
        "type": "string"
      },
      "changed": {
        "description": "Whether the local observed lifecycle state changed; this does not confirm native completion.",
        "type": "boolean"
      }
    },
    "additionalProperties": {}
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
