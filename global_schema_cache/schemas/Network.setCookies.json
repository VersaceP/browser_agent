      "acceptedCount": {
        "description": "Number of cookies accepted by the browser.",
        "type": "number"
      },
      "rejectedCount": {
        "description": "Number of cookies rejected by validation or the browser.",
        "type": "number"
      },
      "set": {
        "description": "Normalized number of cookies set.",
        "type": "number"
