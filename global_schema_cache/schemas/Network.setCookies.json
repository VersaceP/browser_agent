{
  "method": "Network.setCookies",
  "description": "Sets cookies in a page session and reports each accepted or rejected cookie.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:52691626582a5164f1e1aaafb5a9e390e6e1e95ccc27663283f74997776c3737",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID whose session should receive the cookies."
      },
      "cookies": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Cookie name."
            },
            "value": {
              "type": "string",
              "description": "Cookie value."
            },
            "domain": {
              "description": "Cookie domain; omit to use the current page domain.",
              "type": "string"
            },
            "path": {
              "description": "Cookie path; omit for the default path.",
              "type": "string"
            },
            "httpOnly": {
              "description": "Mark the cookie as HttpOnly when true.",
              "type": "boolean"
            },
            "secure": {
              "description": "Mark the cookie as Secure when true.",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "additionalProperties": true
        },
        "description": "Cookies to set for the page session."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why you are setting cookies, e.g., maintaining login state"
      }
    },
    "required": [
      "pageId",
      "cookies",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
