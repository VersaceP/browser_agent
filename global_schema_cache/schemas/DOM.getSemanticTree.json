{
  "method": "DOM.getSemanticTree",
  "description": "Returns structured semantic DOM content for the main document and accessible child frames when the accessibility tree is insufficient. attributes preserve raw markup; relations expose supported explicit ID references within the current frame. Cross-origin or opaque child frames may have ownerId=null even when their frame-local tree is complete.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:46c89baed493789bfb9424bc488513360a2f0047f2a530a729933a4bbe4aff12",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID whose DOM structure should be inspected."
      },
      "id": {
        "description": "Canonical DOM target ID.",
        "type": "string",
        "pattern": "^\\d+:\\d+:\\d+$"
      },
      "selector": {
        "description": "Unique CSS selector for the DOM root.",
        "type": "string",
        "minLength": 1
      },
      "context": {
        "description": "Optional DOM context depth limits.",
        "type": "object",
        "properties": {
          "maxParentDepth": {
            "default": 4,
            "description": "Maximum number of DOM parents to include above the target. Ignored when neither id nor selector is provided.",
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "maxSubtreeDepth": {
            "default": 12,
            "description": "Maximum DOM descendant depth to include.",
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          }
        },
        "required": [
          "maxParentDepth",
          "maxSubtreeDepth"
        ],
        "additionalProperties": true
      },
      "includeShadowDom": {
        "description": "Include Shadow DOM descendants.",
        "type": "boolean"
      },
      "filterNoise": {
        "description": "Filter low-signal DOM nodes.",
        "type": "boolean"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Use this when DOM.getAXTree does not expose the DOM element you need. id and selector stay at the top level; omit both to inspect the document. context.maxParentDepth is ignored for a document-root request. Element bounds and scroll metrics use CSS pixels; bounds are local to each returned Frame viewport. attributes preserve raw attributes, while relations maps supported explicit ARIA/HTML ID-reference tokens to current-frame node IDs and uses null when a target is not in the projection. visibility=visible does not prove hit-testability, out-of-view can be revealed, and not-rendered cannot be used as an Input target. For cross-origin or opaque child frames, route by parentFrameId and frameId because ownerId may be null."
      }
    },
    "required": [
      "pageId",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rootFrameId": {
        "type": "string",
        "description": "Frame ID of the returned document root."
      },
      "frames": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "frameId": {
              "type": "string",
              "minLength": 1,
              "description": "Frame identity for this tree."
            },
            "parentFrameId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Parent frame identity, or null for the root frame."
            },
            "ownerId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Frame-owner node identity. Cross-origin or opaque child frames may keep this null even when status is complete; use parentFrameId and frameId for cross-frame routing."
            },
            "url": {
              "type": "string",
              "description": "Frame URL observed by the renderer."
            },
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "truncated",
                "unavailable"
              ],
              "description": "Frame tree availability."
            },
            "tree": {
              "anyOf": [
                {},
                {
                  "type": "null"
                }
              ],
              "description": "Frame-local semantic tree when available."
            },
            "nodeCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of nodes in this frame tree."
            },
            "truncated": {
              "type": "boolean",
              "description": "Whether this frame was truncated."
            },
            "truncatedReason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reason for truncation, when applicable."
            },
            "error": {
              "description": "Structured failure for an unavailable frame.",
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Stable public frame failure code."
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Concise public frame failure message."
                },
                "suggested_prompt": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Next-observation guidance for this frame."
                }
              },
              "required": [
                "code",
                "message",
                "suggested_prompt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "frameId",
            "parentFrameId",
            "ownerId",
            "url",
            "status",
            "tree",
            "nodeCount",
            "truncated",
            "truncatedReason"
          ],
          "additionalProperties": {},
          "description": "One frame-local semantic tree result."
        },
        "description": "Structured semantic trees for the root document and accessible child frames."
      },
      "summary": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {},
        "description": "Node counts, truncation, and visibility summary."
      },
      "resolutionSource": {
        "description": "Target resolution route used when a target was requested.",
        "type": "string"
      },
      "recoveredTarget": {
        "description": "Snapshot details used when a stale target was recovered.",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "required": [
      "rootFrameId",
      "frames",
      "summary"
    ],
    "additionalProperties": false
  },
