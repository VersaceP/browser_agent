        "type": "string",
        "pattern": "^n_[0-9a-f]{16}$"
      },
      "selector": {
        "description": "Unique CSS selector for one select control.",
        "type": "string",
        "minLength": 1
      },
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID containing the select control."
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Inspect before Input.select to determine the value form and current constraints. Custom controls require normal input interaction."
      }
    },
    "required": [
      "pageId",
      "purpose"
    ],
    "additionalProperties": true
  },
