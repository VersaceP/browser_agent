{
  "method": "Workflow.list",
  "description": "Lists saved Workshop workflows, including disabled records. query and url are mutually exclusive; either can be combined with folderId and limit. Pass workshopId alone to read a complete manifest. limit must be an integer from 1 to 1000 and defaults to 500.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workshopId": {
        "description": "Saved record ID. Use alone, without query, url, folderId, or limit, to read its complete manifest.",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "query": {
        "description": "Non-empty, case-insensitive partial title (name) or description search. Mutually exclusive with url and workshopId.",
        "type": "string",
        "minLength": 1
      },
      "url": {
        "description": "Match the URL hostname against availability rules, including disabled records. Mutually exclusive with query and workshopId.",
        "type": "string",
        "format": "uri"
      },
      "folderId": {
        "description": "Folder filter; null selects root, omission selects all folders.",
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
            "type": "null"
          }
        ]
      },
      "limit": {
        "description": "Maximum summaries to return; integer from 1 to 1000, defaults to 500. Cannot be combined with workshopId.",
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      }
    },
    "additionalProperties": true
  },
