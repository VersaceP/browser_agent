{
  "method": "File.write",
  "description": "Saves content as a local file.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Page ID associated with the current Workflow execution."
      },
      "content": {
        "type": "string",
        "maxLength": 1073741824,
        "description": "Text content to save as UTF-8, up to 1024 MiB of encoded bytes."
      },
      "directory": {
        "default": ".",
        "description": "Relative directory for the exported file.",
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "fileName": {
        "description": "File name, including any extension, without path separators. Defaults to the current task or execution ID.",
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "overwrite": {
        "default": false,
        "description": "Whether an existing file may be replaced.",
        "type": "boolean"
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why the file should be saved locally."
      }
    },
    "required": [
      "pageId",
      "content",
      "directory",
      "overwrite",
      "purpose"
    ],
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "format": "uuid",
