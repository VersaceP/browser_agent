      },
      "bytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "UTF-8 byte length of the saved content."
      },
      "overwritten": {
        "type": "boolean",
        "description": "Whether an existing file was replaced."
      }
    },
    "required": [
      "pageId",
      "savedPath",
      "relativePath",
      "bytes",
      "overwritten"
