{
  "method": "Fleet.close",
  "description": "Closes and destroys the specified browser instance, waits for orderly Client resource cleanup, and reports whether process termination was graceful or forced.",
  "params": {
    "fleetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Fleet ID to close.",
      "required": true
    }
  },
  "requiresPurpose": false
}