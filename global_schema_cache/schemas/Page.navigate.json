{
  "method": "Page.navigate",
  "description": "Navigates to the specified URL.",
  "params": {
    "pageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "required": true
    },
    "url": {
      "type": "string",
      "format": "uri",
      "required": true
    },
    "purpose": {
      "type": "string",
      "description": "Describe why you are navigating to this URL, e.g., visiting a product detail page",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe why you are navigating to this URL, e.g., visiting a product detail page"
}