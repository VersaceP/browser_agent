{
  "method": "Fleet.create",
  "description": "Creates or restores an isolated browser Fleet. Prefer reusing a suitable existing Fleet. Strongly prefer providing a concise, recognizable name and express its responsibilities and purpose through name, scope, or tags.",
  "requiresPurpose": false,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fleetId": {
        "description": "Optional Fleet ID. If provided, reuses existing cache/partition or initializes one with this ID.",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "name": {
        "description": "Optional Fleet name. Strongly recommended: provide a concise, recognizable name. Used only for new Fleets; restoring an existing Fleet preserves its name.",
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "scope": {
        "description": "Optional memory scope label for the Fleet; defaults to fleetId. May express responsibilities or purpose without duplicating name or tags.",
        "type": "string"
      },
      "tags": {
        "description": "Optional tags for a new Fleet. May express responsibilities or purpose without duplicating name or scope. Restoring an existing Fleet preserves its tags.",
        "maxItems": 20,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "additionalProperties": true
  },
  "resultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fleetId": {
        "description": "Created or restored Fleet ID.",
        "type": "string"
      },
      "name": {
        "type": "string",
        "description": "Persisted Fleet name, or an empty string when unnamed."
      },
      "state": {
        "description": "Fleet lifecycle state observed after creation.",
        "type": "string"
      },
      "restored": {
        "description": "Whether an existing authorized Fleet partition was restored.",
        "type": "boolean"
      },
      "partition": {
        "description": "Browser partition identifier used by the Fleet.",
        "type": "string"
      },
      "profileId": {
        "description": "Fingerprint profile ID associated with the Fleet, when configured.",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": {}
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "observation": {
        "type": "string",
        "description": "Facts directly observed by the Action or returned by its declared result schema."
      },
      "suggested_prompt": {
        "type": "string",
        "description": "Guidance to re-observe current state and choose the next operation."
      },
      "data": {
        "description": "Validated business result returned by the Action.",
        "type": "object",
        "properties": {
          "fleetId": {
            "description": "Created or restored Fleet ID.",
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Persisted Fleet name, or an empty string when unnamed."
          },
          "state": {
            "description": "Fleet lifecycle state observed after creation.",
            "type": "string"
          },
          "restored": {
            "description": "Whether an existing authorized Fleet partition was restored.",
            "type": "boolean"
          },
          "partition": {
            "description": "Browser partition identifier used by the Fleet.",
            "type": "string"
          },
          "profileId": {
            "description": "Fingerprint profile ID associated with the Fleet, when configured.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": {}
      }
    },
    "required": [
      "observation",
      "suggested_prompt",
      "data"
    ],
    "additionalProperties": false
  },
  "failureSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "description": "Stable public failure code."
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "description": "Concise public explanation of the failure."
      },
      "observation": {
        "description": "Directly observed failure fact.",
        "type": "string"
      },
      "suggested_prompt": {
        "description": "Guidance for the next recovery operation.",
        "type": "string"
      },
      "details": {
        "description": "Public details filtered by the failure definition allowlist.",
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      },
      "blockingInteractions": {
        "type": "object",
        "properties": {
          "dialogs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Identifier of the pending dialog."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "alert",
                    "confirm",
                    "prompt",
                    "beforeunload",
                    "file-save",
                    "file-open",
                    "directory"
                  ],
                  "description": "Kind of pending dialog."
                },
                "message": {
                  "type": "string",
                  "maxLength": 16384,
                  "description": "Dialog message or title."
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 4096,
                  "description": "Default prompt value, without user input."
                },
                "supportedActions": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "cancel",
                      "select-files"
                    ]
                  },
                  "description": "Operations supported by this dialog."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "opening",
                    "open",
                    "resolving"
                  ],
                  "description": "Current native lifecycle state."
                },
                "multiple": {
                  "description": "Whether the original file request accepts multiple files.",
                  "type": "boolean"
                },
                "acceptTypes": {
                  "description": "File filters from the original request; browser and permission checks remain authoritative.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downloadId": {
                  "description": "Existing download waiting for this save destination.",
                  "type": "string",
                  "minLength": 1
                },
                "pageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "description": "Page that owns this active native dialog."
                }
              },
              "required": [
                "id",
                "type",
                "message",
                "defaultValue",
                "supportedActions",
                "state",
                "pageId"
              ],
              "additionalProperties": false
            },
            "description": "Current native dialogs, independently of the business result."
          }
        },
        "required": [
          "dialogs"
        ],
        "additionalProperties": false,
        "description": "Present only when current native dialogs were observed."
      }
    },
    "required": [
      "code",
      "message"
    ],
    "additionalProperties": false
  }
}