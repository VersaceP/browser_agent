{
  "method": "Download.start",
  "description": "Starts a direct URL download or reserves the next download initiated by a page for five minutes.",
  "requiresPurpose": true,
  "actionRevision": "sha256:21044b9db2d20b3db80d8966402cfcaebd467281b4981c8f524b9f476563857f",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Page ID whose WebContents should initiate the download."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Direct file URL. The browser receives this value unchanged."
          },
          "savePath": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace-relative or absolute destination path."
          },
          "overwrite": {
            "default": false,
            "description": "Whether an existing destination may be replaced.",
            "type": "boolean"
          },
          "purpose": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "string",
            "minLength": 1,
            "description": "Describe why you are downloading this file, e.g., saving report data"
          }
        },
        "required": [
          "pageId",
          "url",
          "savePath",
          "overwrite",
          "purpose"
        ],
        "additionalProperties": true
      },
      {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "format": "uuid",
