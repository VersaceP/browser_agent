{
  "method": "Download.list",
  "description": "Lists recent download records for a Fleet, optionally filtered by ID or lifecycle state.",
  "requiresPurpose": true,
  "catalogRevision": "sha256:2e55483dc7290e98387fd0a733945a10ed267ea41932e03ab02fd12c67f68fe5",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fleetId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Fleet ID whose downloads should be queried."
      },
      "downloadId": {
        "description": "Optional opaque download ID to inspect.",
        "type": "string",
        "minLength": 1
      },
      "states": {
        "description": "Optional lifecycle states to include.",
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "waiting",
            "downloading",
            "paused",
            "completed",
            "failed",
            "cancelled"
          ]
        }
      },
      "limit": {
        "default": 100,
        "description": "Maximum recent download records to return.",
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "purpose": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "minLength": 1,
        "description": "Describe why you are viewing downloads, e.g., checking if a download has completed"
      }
    },
    "required": [
      "fleetId",
      "limit",
      "purpose"
    ],
    "additionalProperties": true
  },
