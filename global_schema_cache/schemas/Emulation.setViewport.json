{
  "method": "Emulation.setViewport",
  "description": "Sets the browser viewport size.",
  "params": {
    "pageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "required": true
    },
    "width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 3840,
      "required": true
    },
    "height": {
      "type": "integer",
      "minimum": 240,
      "maximum": 2160,
      "required": true
    },
    "deviceScaleFactor": {
      "default": 1,
      "type": "number",
      "minimum": 1,
      "maximum": 3,
      "required": true
    },
    "purpose": {
      "type": "string",
      "description": "Describe why you are changing the viewport, e.g., testing mobile responsive layout",
      "required": true
    }
  },
  "requiresPurpose": true,
  "purposeHint": "Describe why you are changing the viewport, e.g., testing mobile responsive layout"
}