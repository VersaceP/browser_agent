{
  "provider": "anthropic",
  "model_id": "YOUR_MODEL_ID",
  "api_key": "YOUR_API_KEY",
  "base_url": "https://your-llm-endpoint.example/v1",
  "llm_api_timeout_seconds": 240,
  "llm_timeout_max_retries": 2,
  "llm_timeout_retry_interval_seconds": 30,
  "extra_params": {
    "temperature": 0.5,
    "max_tokens": 8192,
    "cache_control_mode": "auto",
    "tool_choice": "required"
  },
  "vl": {
    "enabled": false,
    "model_id": "qwen-vl-xxx",
    "base_url": "https://your-qwen-compatible-endpoint.example/v1",
    "api_key": "YOUR_VL_API_KEY",
    "max_checks_per_worker": 5,
    "default_timeout_seconds": 60,
    "captcha_solve_timeout_seconds": 150,
    "captcha_solve_budget_seconds": 240,
    "captcha_solve_extra_params": {
      "extra_body": {
        "enable_thinking": false
      }
    }
  },
  "plan_validator": {
    "enabled": false,
    "provider": "openai",
    "model_id": "YOUR_INDEPENDENT_VALIDATOR_MODEL_ID",
    "base_url": "https://your-validator-endpoint.example/v1",
    "api_key_env": "PLAN_VALIDATOR_API_KEY",
    "max_tokens": 8000
  },
  "browser": {
    "request_shape": "jsonrpc",
    "jwt_token_env": "ABCP_JWT_TOKEN"
  },
  "harness": {
    "max_steps": 50,
    "lead_max_steps": 50,
    "worker_max_steps": 50,
    "workflow_execution_enabled": false,
    "max_task_fleets": 3,
    "semantic_tree": "internal"
  }
}
